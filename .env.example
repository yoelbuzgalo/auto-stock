# Demo-first defaults
AUTO_STOCK_PROVIDER=demo
AUTO_STOCK_BROKER=none
AUTO_STOCK_LOG_LEVEL=INFO
AUTO_STOCK_STORAGE_DIR=.auto_stock

# Provider tuning
AUTO_STOCK_HTTP_TIMEOUT=8
AUTO_STOCK_CACHE_TTL_SECONDS=15
AUTO_STOCK_RETRY_ATTEMPTS=2
AUTO_STOCK_DEMO_SEED=7

# Polygon
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://data.alpaca.markets

# Schwab market data + broker
SCHWAB_ACCESS_TOKEN=
SCHWAB_REFRESH_TOKEN=
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_ACCOUNT_ID=
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_BASE_URL=https://api.schwabapi.com

# Notifications
# Discord uses a webhook URL. Twilio SMS uses plain E.164 phone numbers.
# Twilio WhatsApp can use either whatsapp:+15551234567 or +15551234567.
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_SMS_FROM=
TWILIO_SMS_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
